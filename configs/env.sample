# Sample environment configuration for Databricks pipeline

# Databricks workspace configuration
DATABRICKS_HOST=<your-databricks-host>
DATABRICKS_TOKEN=<your-databricks-token>

# S3 configuration
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
S3_BUCKET_NAME=<your-s3-bucket-name>

# Delta Lake configuration
DELTA_LAKE_PATH=<your-delta-lake-path>

# Other environment variables
ENVIRONMENT=<your-environment>  # e.g., development, staging, production
LOG_LEVEL=<your-log-level>  # e.g., INFO, DEBUG, ERROR