{
  "workspace": {
    "name": "databricks-game-audience-pipeline",
    "region": "us-west-2",
    "credentials": {
      "access_key": "<YOUR_AWS_ACCESS_KEY>",
      "secret_key": "<YOUR_AWS_SECRET_KEY>"
    },
    "s3": {
      "bucket": "uni-kishore-pipeline",
      "prefix": "data/"
    },
    "delta": {
      "location": "dbfs:/mnt/delta/"
    },
    "jobs": {
      "default_cluster": {
        "spark_version": "7.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2
      },
      "schedule": {
        "cron_expression": "0 */5 * * *",
        "timezone": "UTC"
      }
    }
  }
}